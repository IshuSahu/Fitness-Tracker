# Copy to .env and fill in. Never commit .env itself.

# Supabase Postgres, Session pooler URI (Project Settings -> Database ->
# Connection string -> URI -> Session pooler tab -- NOT "Direct connection",
# which is IPv6-only and won't resolve from most hosts). Percent-encode
# special characters in the password (e.g. "@" -> "%40").
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# For the frontend's login-only supabase-js client. The anon key is meant
# to be public (that's how Supabase's client-side auth works); it's only
# used here for signInWithPassword/getSession/signOut, never for data.
# Also used server-side to build the JWKS URL that verifies incoming tokens
# (this project uses Supabase's newer asymmetric JWT Signing Keys, verified
# via its public JWKS endpoint -- there's no separate secret to configure).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>

# Your Supabase auth user's UUID (Authentication -> Users). The backend
# rejects any valid token whose "sub" claim isn't this -- this app is
# single-user by design.
ALLOWED_USER_ID=<your auth uuid>
